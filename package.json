{
  "name": "pixel-ia-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Estudio de pixel art con editor completo, capas, paletas e integración con IA local (modelos pequeños tipo Ollama)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test test/unit/*.test.ts",
    "test:e2e": "vite build && node test/e2e.test.mjs",
    "test:ai": "node test/ai-live.ts",
    "test:ai:tiles": "node test/ai-live-tiles.ts",
    "test:all": "npm run test && npm run test:e2e",
    "screenshot": "vite build && node test/screenshot.mjs",
    "previews": "vite build && node test/generate-previews.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
